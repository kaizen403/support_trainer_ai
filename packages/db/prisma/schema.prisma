generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  members          Member[]
  trainingSessions TrainingSession[]
  assignments      Assignment[]
  assignmentsAssignedBy Assignment[] @relation("AssignmentAssignedBy")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activeOrganizationId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     Member[]
  invitations Invitation[]
  trainings   Training[]
  knowledgeDocuments KnowledgeDocument[]
  personas    Persona[]
  scenarios   Scenario[]
}

model Member {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invitation {
  id             String   @id @default(cuid())
  email          String
  organizationId String
  role           String   @default("member")
  status         String   @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// =============================================================================
// Application Models
// =============================================================================

model Training {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String
  systemPrompt   String // AI persona instructions
  mode           TrainingMode @default(SIMULATION)
  skillTags      String[] @default([])
  config         Json?
  scenarioId      String?
  shareToken      String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scenario           Scenario?          @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  knowledgeDocuments KnowledgeDocument[]
  sessions           TrainingSession[]
  assignments        Assignment[]
  personas           Persona[]

  @@index([shareToken])
}

model Scenario {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  description    String
  personaPreset  ScenarioPersonaPreset
  temperament    String
  expertise       String
  complexity     String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  knowledgeDocuments KnowledgeDocument[]
  trainings          Training[]

  @@index([organizationId])
}

model KnowledgeDocument {
  id         String                       @id @default(cuid())
  trainingId String?
  organizationId String?
  filename   String
  documentType DocumentType @default(OTHER)
  format     DocumentFormat @default(TXT)
  ingestionStatus IngestionStatus @default(PROCESSING)
  content    String
  embedding  Unsupported("vector(1536)")? // OpenAI ada-002 embedding
  createdAt  DateTime                     @default(now())
  updatedAt  DateTime                     @updatedAt

  training     Training?    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personas     Persona[]
  scenarios    Scenario[]

  @@index([trainingId])
  @@index([organizationId])
}

model TrainingSession {
  id            String        @id @default(cuid())
  trainingId    String
  userId        String
  avatarName    String // Generated AI customer name
  avatarPersona String // Generated personality
  mode          TrainingMode @default(SIMULATION)
  personaId     String?
  personaSnapshot Json?
  skillTags     String[] @default([])
  status        SessionStatus @default(ACTIVE)
  startedAt     DateTime      @default(now())
  endedAt       DateTime?
  transcript    Json? // Full conversation transcript
  coachingNotes Json?
  recordingUrl  String?
  recordingStatus RecordingStatus @default(NOT_STARTED)
  recordingMetadata Json?

  training   Training    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona    Persona?    @relation(fields: [personaId], references: [id], onDelete: SetNull)
  assessment Assessment?

  @@index([userId, startedAt])
  @@index([trainingId])
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum TrainingMode {
  SIMULATION
  GUIDED_INTERVIEW
}

enum DocumentType {
  PRODUCT
  PERSONA
  SCRIPT
  OBJECTION
  POLICY
  OTHER
}

enum ScenarioPersonaPreset {
  RUDE
  CHILL
  UNEXPECTED
  NEUTRAL
  DEMANDING
}

enum DocumentFormat {
  PDF
  TXT
  DOCX
  MD
}

enum RecordingStatus {
  NOT_STARTED
  RECORDING
  COMPLETED
  FAILED
}

enum IngestionStatus {
  PROCESSING
  INDEXED
  FAILED
}

model Assessment {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  score        Int // 0-100
  overallScore Int?
  clarityScore Int?
  protocolAdherenceScore Int?
  empathyScore Int?
  conversionPotentialScore Int?
  feedback     String
  strengths    String[]
  improvements String[]
  categories   Json?
  highlights   Json?
  coachingReport Json?
  citations    Json? // Array of {documentId, chunkContent, deviation, recommendation}
  createdAt    DateTime @default(now())

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Persona {
  id             String   @id @default(cuid())
  organizationId String
  trainingId     String?
  name           String
  description    String
  traits         Json?
  tags           String[] @default([])
  sourceDocumentId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  training     Training?    @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  sourceDocument KnowledgeDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  sessions     TrainingSession[]

  @@index([organizationId])
  @@index([trainingId])
}

model Assignment {
  id           String   @id @default(cuid())
  trainingId   String
  userId       String
  assignedById String?
  status       AssignmentStatus @default(ASSIGNED)
  dueAt        DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([trainingId])
  @@index([userId])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
